generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  active
  inactive
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  noShow
}

enum AppointmentType {
  initial
  followUp
}

enum ArrivalStatus {
  expected
  arrived
  queueReady
}

enum QueueSessionStatus {
  notStarted
  open
  paused
  closed
}

enum QueueEntryStatus {
  waiting
  called
  inConsultation
  completed
  noResponse
  removed
}

enum NotificationPriority {
  high
  normal
  information
}

enum AuditOutcome {
  succeeded
  denied
  failed
}

enum IdentityRole {
  patient
  receptionist
  doctor
  clinicManager
  platformAdministrator
}

enum AuthenticationEventType {
  otpRequested
  otpVerified
  loginSucceeded
  loginFailed
  logout
  logoutAll
  refresh
  refreshReuseDetected
  lockout
}

enum PatientGender {
  female
  male
  unspecified
}

enum DoctorGender {
  female
  male
  unspecified
}

enum DoctorStatus {
  active
  inactive
  archived
}

enum DoctorAvailabilityStatus {
  available
  unavailable
}

enum ScheduleExceptionKind {
  working
  closed
}

enum FamilyRelationshipType {
  self
  mother
  father
  son
  daughter
  brother
  sister
  grandfather
  grandmother
  wife
  husband
  other
}

model Organization {
  id                       String                       @id @default(uuid(7)) @db.Uuid
  name                     String
  status                   RecordStatus                 @default(active)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinics                  Clinic[]
  memberships              ClinicMembership[]
  appointments             Appointment[]
  appointmentArrivals      AppointmentArrival[]
  arrivalAudits            ArrivalAudit[]
  queueSessions            QueueSession[]
  queueActivities          QueueActivity[]
  queueAudits              QueueAudit[]
  notifications            NotificationRecord[]
  audits                   AuditEvent[]
  patientRegistrations     OrganizationPatientProfile[]
  identityRoles            IdentityRoleAssignment[]
  sessionFamilies          SessionFamily[]
  doctors                  Doctor[]
  clinicWorkingHours       ClinicWorkingHours[]
  doctorWeeklySchedules    DoctorWeeklySchedule[]
  doctorBreaks             DoctorBreak[]
  doctorLeaves             DoctorLeave[]
  doctorHolidays           DoctorHoliday[]
  doctorScheduleExceptions DoctorScheduleException[]

  @@map("organizations")
}

model Clinic {
  id                       String                    @id @default(uuid(7)) @db.Uuid
  organizationId           String                    @map("organization_id") @db.Uuid
  name                     String
  code                     String
  timezone                 String
  status                   RecordStatus              @default(active)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships              ClinicMembership[]
  doctorSchedules          DoctorSchedule[]
  appointments             Appointment[]
  appointmentArrivals      AppointmentArrival[]
  arrivalAudits            ArrivalAudit[]
  queueSessions            QueueSession[]
  queueActivities          QueueActivity[]
  queueAudits              QueueAudit[]
  notifications            NotificationRecord[]
  audits                   AuditEvent[]
  doctorAssignments        DoctorClinicAssignment[]
  identityRoles            IdentityRoleAssignment[]
  sessionFamilies          SessionFamily[]
  workingHours             ClinicWorkingHours[]
  doctorWeeklySchedules    DoctorWeeklySchedule[]
  doctorBreaks             DoctorBreak[]
  doctorLeaves             DoctorLeave[]
  doctorHolidays           DoctorHoliday[]
  doctorScheduleExceptions DoctorScheduleException[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("clinics")
}

model User {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  status               RecordStatus             @default(active)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientAccount       PatientAccount?
  staffAccount         StaffAccount?
  memberships          ClinicMembership[]
  refreshSessions      RefreshSession[]
  notifications        NotificationRecord[]
  audits               AuditEvent[]
  arrivalAudits        ArrivalAudit[]
  queueActivities      QueueActivity[]
  queueAudits          QueueAudit[]
  roles                IdentityRoleAssignment[]
  sessionFamilies      SessionFamily[]
  authenticationEvents AuthenticationEvent[]
  authorizationVersion Int                      @default(1) @map("authorization_version")
  roleVersion          Int                      @default(1) @map("role_version")

  @@map("users")
}

model IdentityRoleAssignment {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  clinicId       String?       @map("clinic_id") @db.Uuid
  role           IdentityRole
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic?       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)

  @@unique([userId, organizationId, clinicId, role])
  @@index([organizationId, clinicId, role])
  @@map("identity_role_assignments")
}

model PatientAccount {
  id                    String                       @id @default(uuid(7)) @db.Uuid
  userId                String                       @unique @map("user_id") @db.Uuid
  normalizedPhoneNumber String                       @unique @map("normalized_phone_number")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  profiles              PatientProfile[]
  relationships         FamilyRelationship[]
  activeProfile         PatientAccountActiveProfile?

  @@map("patient_accounts")
}

model PatientProfile {
  id                        String                       @id @default(uuid(7)) @db.Uuid
  patientAccountId          String                       @map("patient_account_id") @db.Uuid
  firstName                 String                       @map("first_name")
  lastName                  String                       @map("last_name")
  dateOfBirth               DateTime                     @map("date_of_birth") @db.Date
  gender                    PatientGender                @default(unspecified)
  status                    RecordStatus                 @default(active)
  version                   Int                          @default(1)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientAccount            PatientAccount               @relation(fields: [patientAccountId], references: [id], onDelete: Restrict)
  relationships             FamilyRelationship[]
  organizationRegistrations OrganizationPatientProfile[]
  appointmentArrivals       AppointmentArrival[]
  activeForAccount          PatientAccountActiveProfile?

  @@unique([patientAccountId, id])
  @@index([patientAccountId])
  @@index([patientAccountId, status])
  @@map("patient_profiles")
}

model FamilyRelationship {
  id               String                 @id @default(uuid(7)) @db.Uuid
  patientAccountId String                 @map("patient_account_id") @db.Uuid
  patientProfileId String                 @map("patient_profile_id") @db.Uuid
  relationship     FamilyRelationshipType
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  patientAccount   PatientAccount         @relation(fields: [patientAccountId], references: [id], onDelete: Restrict)
  patientProfile   PatientProfile         @relation(fields: [patientAccountId, patientProfileId], references: [patientAccountId, id], onDelete: Restrict)

  @@unique([patientAccountId, patientProfileId])
  @@map("family_relationships")
}

model PatientAccountActiveProfile {
  patientAccountId String         @id @map("patient_account_id") @db.Uuid
  patientProfileId String         @unique @map("patient_profile_id") @db.Uuid
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Restrict)
  patientProfile   PatientProfile @relation(fields: [patientAccountId, patientProfileId], references: [patientAccountId, id], onDelete: Restrict)

  @@unique([patientAccountId, patientProfileId])
  @@map("patient_account_active_profile")
}

model StaffAccount {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  doctor       Doctor?

  @@map("staff_accounts")
}

model ClinicMembership {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, clinicId, userId, role])
  @@index([userId, status])
  @@map("clinic_memberships")
}

model Doctor {
  id                   String                        @id @default(uuid(7)) @db.Uuid
  organizationId       String                        @map("organization_id") @db.Uuid
  staffAccountId       String                        @unique @map("staff_account_id") @db.Uuid
  firstName            String                        @map("first_name")
  lastName             String                        @map("last_name")
  displayName          String                        @map("display_name")
  gender               DoctorGender
  status               DoctorStatus                  @default(active)
  licenseNumber        String                        @map("license_number")
  yearsOfExperience    Int                           @map("years_of_experience")
  biography            String                        @default("")
  languages            String[]
  profilePhotoKey      String?                       @map("profile_photo_key")
  version              Int                           @default(1)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staffAccount         StaffAccount                  @relation(fields: [staffAccountId], references: [id], onDelete: Restrict)
  schedules            DoctorSchedule[]
  clinicAssignments    DoctorClinicAssignment[]
  specialtyAssignments DoctorSpecialtyAssignment[]
  availability         DoctorAvailabilityFoundation?
  weeklySchedules      DoctorWeeklySchedule[]
  breaks               DoctorBreak[]
  leaves               DoctorLeave[]
  holidays             DoctorHoliday[]
  scheduleExceptions   DoctorScheduleException[]

  @@unique([organizationId, id])
  @@unique([organizationId, licenseNumber])
  @@index([organizationId, status, displayName])
  @@map("doctors")
}

model Specialty {
  id          String                      @id @default(uuid(7)) @db.Uuid
  code        String                      @unique
  displayName String                      @map("display_name")
  status      RecordStatus                @default(active)
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctors     DoctorSpecialtyAssignment[]

  @@index([status, displayName])
  @@map("specialties")
}

model DoctorSpecialtyAssignment {
  doctorId    String    @map("doctor_id") @db.Uuid
  specialtyId String    @map("specialty_id") @db.Uuid
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([doctorId, specialtyId])
  @@index([specialtyId, doctorId])
  @@map("doctor_specialties")
}

model DoctorClinicAssignment {
  organizationId String         @map("organization_id") @db.Uuid
  clinicId       String         @map("clinic_id") @db.Uuid
  doctorId       String         @map("doctor_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  status         RecordStatus   @default(active)
  clinic         Clinic         @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor         @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)
  appointments   Appointment[]
  queueSessions  QueueSession[]

  @@id([organizationId, clinicId, doctorId])
  @@map("doctor_clinic_assignments")
}

model DoctorAvailabilityFoundation {
  doctorId             String                   @id @map("doctor_id") @db.Uuid
  status               DoctorAvailabilityStatus @default(unavailable)
  acceptingNewPatients Boolean                  @default(false) @map("accepting_new_patients")
  nextAvailableAt      DateTime?                @map("next_available_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor               Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([status, nextAvailableAt])
  @@map("doctor_availability_foundation")
}

model ClinicWorkingHours {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  weekday        Int
  opensMinute    Int          @map("opens_minute")
  closesMinute   Int          @map("closes_minute")
  status         RecordStatus @default(active)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, weekday, status])
  @@map("clinic_working_hours")
}

model DoctorWeeklySchedule {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  doctorId       String       @map("doctor_id") @db.Uuid
  weekday        Int
  startsMinute   Int          @map("starts_minute")
  endsMinute     Int          @map("ends_minute")
  status         RecordStatus @default(active)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor       @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, weekday, status])
  @@map("doctor_weekly_schedule")
}

model DoctorBreak {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  doctorId       String       @map("doctor_id") @db.Uuid
  weekday        Int
  startsMinute   Int          @map("starts_minute")
  endsMinute     Int          @map("ends_minute")
  status         RecordStatus @default(active)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor       @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, weekday, status])
  @@map("doctor_breaks")
}

model DoctorLeave {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  doctorId       String       @map("doctor_id") @db.Uuid
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  status         RecordStatus @default(active)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor       @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, startsAt, endsAt, status])
  @@map("doctor_leave")
}

model DoctorHoliday {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  doctorId       String       @map("doctor_id") @db.Uuid
  name           String
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  status         RecordStatus @default(active)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor       @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, startsAt, endsAt, status])
  @@map("doctor_holidays")
}

model DoctorScheduleException {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  clinicId       String                @map("clinic_id") @db.Uuid
  doctorId       String                @map("doctor_id") @db.Uuid
  kind           ScheduleExceptionKind
  startsAt       DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime              @map("ends_at") @db.Timestamptz(3)
  status         RecordStatus          @default(active)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic                @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor                @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, startsAt, endsAt, status])
  @@map("doctor_schedule_exceptions")
}

model OrganizationPatientProfile {
  organizationId   String               @map("organization_id") @db.Uuid
  patientProfileId String               @map("patient_profile_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  status           RecordStatus         @default(active)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patientProfile   PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  appointments     Appointment[]
  queueEntries     QueueEntry[]
  notifications    NotificationRecord[]

  @@id([organizationId, patientProfileId])
  @@map("organization_patient_profiles")
}

model DoctorSchedule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  clinic         Clinic   @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctor         Doctor   @relation(fields: [organizationId, doctorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clinicId, doctorId, startsAt])
  @@map("doctor_schedules")
}

model Appointment {
  id                  String                     @id @default(uuid(7)) @db.Uuid
  organizationId      String                     @map("organization_id") @db.Uuid
  clinicId            String                     @map("clinic_id") @db.Uuid
  doctorId            String                     @map("doctor_id") @db.Uuid
  patientProfileId    String                     @map("patient_profile_id") @db.Uuid
  publicReference     String                     @unique @default(dbgenerated()) @map("public_reference")
  type                AppointmentType            @default(initial)
  reason              String                     @default("General consultation")
  startsAt            DateTime                   @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime                   @default(dbgenerated()) @map("ends_at") @db.Timestamptz(3)
  durationMinutes     Int                        @map("duration_minutes")
  feeIqd              Int                        @map("fee_iqd")
  status              AppointmentStatus          @default(scheduled)
  cancellationReason  String?                    @map("cancellation_reason")
  cancelledAt         DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic              Clinic                     @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctorAssignment    DoctorClinicAssignment     @relation(fields: [organizationId, clinicId, doctorId], references: [organizationId, clinicId, doctorId], onDelete: Restrict)
  patientRegistration OrganizationPatientProfile @relation(fields: [organizationId, patientProfileId], references: [organizationId, patientProfileId], onDelete: Restrict)
  events              AppointmentEvent[]
  arrival             AppointmentArrival?
  queueEntries        QueueEntry[]

  @@unique([organizationId, clinicId, id])
  @@unique([organizationId, clinicId, id, patientProfileId])
  @@unique([organizationId, id])
  @@index([organizationId, clinicId, startsAt])
  @@index([organizationId, doctorId, startsAt])
  @@index([patientProfileId, startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  appointmentId  String      @map("appointment_id") @db.Uuid
  type           String
  payload        Json
  occurredAt     DateTime    @map("occurred_at") @db.Timestamptz(3)
  appointment    Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, appointmentId, occurredAt])
  @@map("appointment_events")
}

model AppointmentArrival {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  clinicId         String         @map("clinic_id") @db.Uuid
  appointmentId    String         @unique @map("appointment_id") @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  status           ArrivalStatus  @default(expected)
  arrivedAt        DateTime?      @map("arrived_at") @db.Timestamptz(3)
  queueReadyAt     DateTime?      @map("queue_ready_at") @db.Timestamptz(3)
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic           Clinic         @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  appointment      Appointment    @relation(fields: [organizationId, clinicId, appointmentId, patientProfileId], references: [organizationId, clinicId, id, patientProfileId], onDelete: Restrict)
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  audits           ArrivalAudit[]
  queueEntries     QueueEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, clinicId, id], map: "arrival_tenant_clinic_key")
  @@unique([organizationId, clinicId, appointmentId], map: "arrival_appointment_scope_key")
  @@unique([organizationId, clinicId, appointmentId, patientProfileId], map: "arrival_patient_scope_key")
  @@index([organizationId, clinicId, status, createdAt])
  @@index([patientProfileId, status])
  @@map("appointment_arrivals")
}

model ArrivalAudit {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  clinicId       String             @map("clinic_id") @db.Uuid
  arrivalId      String             @map("arrival_id") @db.Uuid
  actorUserId    String             @map("actor_user_id") @db.Uuid
  fromStatus     ArrivalStatus      @map("from_status")
  toStatus       ArrivalStatus      @map("to_status")
  occurredAt     DateTime           @map("occurred_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic             @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  arrival        AppointmentArrival @relation(fields: [organizationId, clinicId, arrivalId], references: [organizationId, clinicId, id], onDelete: Restrict)
  actorUser      User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([arrivalId, fromStatus, toStatus], map: "arrival_audit_transition_key")
  @@index([organizationId, arrivalId, occurredAt])
  @@map("arrival_audits")
}

model QueueSession {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  clinicId           String                 @map("clinic_id") @db.Uuid
  doctorId           String                 @map("doctor_id") @db.Uuid
  operationalDate    DateTime               @map("operational_date") @db.Date
  effectiveTimezone  String                 @default("Asia/Baghdad") @map("effective_timezone")
  recallGraceMinutes Int                    @default(5) @map("recall_grace_minutes")
  status             QueueSessionStatus     @default(notStarted)
  nextTicket         Int                    @default(1) @map("next_ticket")
  openedAt           DateTime?              @map("opened_at") @db.Timestamptz(3)
  pausedAt           DateTime?              @map("paused_at") @db.Timestamptz(3)
  closedAt           DateTime?              @map("closed_at") @db.Timestamptz(3)
  pauseReason        String?                @map("pause_reason")
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic             Clinic                 @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  doctorAssignment   DoctorClinicAssignment @relation(fields: [organizationId, clinicId, doctorId], references: [organizationId, clinicId, doctorId], onDelete: Restrict)
  entries            QueueEntry[]
  activities         QueueActivity[]
  audits             QueueAudit[]

  @@unique([organizationId, clinicId, doctorId, operationalDate])
  @@unique([organizationId, clinicId, id])
  @@map("queue_sessions")
}

model QueueEntry {
  id                    String                     @id @default(uuid(7)) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  clinicId              String                     @map("clinic_id") @db.Uuid
  queueSessionId        String                     @map("queue_session_id") @db.Uuid
  appointmentId         String                     @map("appointment_id") @db.Uuid
  arrivalId             String                     @map("arrival_id") @db.Uuid
  patientProfileId      String                     @map("patient_profile_id") @db.Uuid
  ticketNumber          Int                        @map("ticket_number")
  status                QueueEntryStatus           @default(waiting)
  calledAt              DateTime?                  @map("called_at") @db.Timestamptz(3)
  recalledAt            DateTime?                  @map("recalled_at") @db.Timestamptz(3)
  consultationStartedAt DateTime?                  @map("consultation_started_at") @db.Timestamptz(3)
  completedAt           DateTime?                  @map("completed_at") @db.Timestamptz(3)
  noResponseAt          DateTime?                  @map("no_response_at") @db.Timestamptz(3)
  recallDeadlineAt      DateTime?                  @map("recall_deadline_at") @db.Timestamptz(3)
  version               Int                        @default(1)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  queueSession          QueueSession               @relation(fields: [organizationId, clinicId, queueSessionId], references: [organizationId, clinicId, id], onDelete: Restrict)
  appointment           Appointment                @relation(fields: [organizationId, clinicId, appointmentId], references: [organizationId, clinicId, id], onDelete: Restrict)
  arrival               AppointmentArrival         @relation(fields: [organizationId, clinicId, arrivalId], references: [organizationId, clinicId, id], onDelete: Restrict)
  patientRegistration   OrganizationPatientProfile @relation(fields: [organizationId, patientProfileId], references: [organizationId, patientProfileId], onDelete: Restrict)
  activities            QueueActivity[]
  audits                QueueAudit[]

  @@unique([queueSessionId, ticketNumber])
  @@unique([queueSessionId, appointmentId])
  @@unique([arrivalId])
  @@unique([organizationId, clinicId, queueSessionId, id], map: "queue_entry_history_scope_key")
  @@index([organizationId, queueSessionId, status, ticketNumber])
  @@map("queue_entries")
}

model QueueActivity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  queueSessionId String       @map("queue_session_id") @db.Uuid
  queueEntryId   String?      @map("queue_entry_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  action         String
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  queueSession   QueueSession @relation(fields: [organizationId, clinicId, queueSessionId], references: [organizationId, clinicId, id], onDelete: Restrict, map: "queue_activities_session_fkey")
  queueEntry     QueueEntry?  @relation(fields: [organizationId, clinicId, queueSessionId, queueEntryId], references: [organizationId, clinicId, queueSessionId, id], onDelete: Restrict, map: "queue_activities_entry_scope_fkey")
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, queueSessionId, occurredAt])
  @@map("queue_activities")
}

model QueueAudit {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clinicId       String       @map("clinic_id") @db.Uuid
  queueSessionId String       @map("queue_session_id") @db.Uuid
  queueEntryId   String?      @map("queue_entry_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  action         String
  requestId      String       @map("request_id")
  metadata       Json?
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic       @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  queueSession   QueueSession @relation(fields: [organizationId, clinicId, queueSessionId], references: [organizationId, clinicId, id], onDelete: Restrict, map: "queue_audits_session_fkey")
  queueEntry     QueueEntry?  @relation(fields: [organizationId, clinicId, queueSessionId, queueEntryId], references: [organizationId, clinicId, queueSessionId, id], onDelete: Restrict, map: "queue_audits_entry_scope_fkey")
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, queueSessionId, occurredAt])
  @@map("queue_audits")
}

model NotificationRecord {
  id                  String                      @id @default(uuid(7)) @db.Uuid
  deliverySequence    BigInt                      @unique @default(autoincrement()) @map("delivery_sequence")
  sourceOutboxEventId String                      @map("source_outbox_event_id") @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  clinicId            String                      @map("clinic_id") @db.Uuid
  recipientUserId     String                      @map("recipient_user_id") @db.Uuid
  patientProfileId    String?                     @map("patient_profile_id") @db.Uuid
  type                String
  priority            NotificationPriority        @default(normal)
  payload             Json
  occurredAt          DateTime                    @map("occurred_at") @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt              DateTime?                   @map("read_at") @db.Timestamptz(3)
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic              Clinic                      @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)
  recipientUser       User                        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  patientRegistration OrganizationPatientProfile? @relation(fields: [organizationId, patientProfileId], references: [organizationId, patientProfileId], onDelete: Restrict)
  sourceOutboxEvent   OutboxEvent                 @relation(fields: [sourceOutboxEventId], references: [id], onDelete: Restrict)

  @@unique([sourceOutboxEventId, recipientUserId, type])
  @@index([recipientUserId, deliverySequence])
  @@index([recipientUserId, readAt, deliverySequence])
  @@index([organizationId, clinicId, recipientUserId, deliverySequence])
  @@map("notification_records")
}

/// Migration-only preservation store. Runtime SQL has no access.
model NotificationRecordArchive {
  id               String               @id @db.Uuid
  organizationId   String?              @map("organization_id") @db.Uuid
  clinicId         String?              @map("clinic_id") @db.Uuid
  recipientUserId  String               @map("recipient_user_id") @db.Uuid
  patientProfileId String?              @map("patient_profile_id") @db.Uuid
  type             String
  priority         NotificationPriority
  payload          Json
  occurredAt       DateTime             @map("occurred_at") @db.Timestamptz(3)
  readAt           DateTime?            @map("read_at") @db.Timestamptz(3)
  archivedAt       DateTime             @default(now()) @map("archived_at") @db.Timestamptz(3)
  archiveReason    String               @map("archive_reason")

  @@map("notification_record_archive")
}

model RefreshSession {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  deviceId     String        @map("device_id")
  tokenHash    String        @unique @map("token_hash")
  familyId     String        @map("family_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt   DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(3)
  platform     String
  userAgent    String?       @map("user_agent")
  ipHash       String?       @map("ip_hash")
  replacedById String?       @map("replaced_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  family       SessionFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

model SessionFamily {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  role           IdentityRole
  organizationId String?          @map("organization_id") @db.Uuid
  clinicId       String?          @map("clinic_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions       RefreshSession[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic?          @relation(fields: [organizationId, clinicId], references: [organizationId, id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("session_families")
}

model OtpChallenge {
  id                    String    @id @default(uuid(7)) @db.Uuid
  normalizedPhoneNumber String    @map("normalized_phone_number")
  otpHash               String    @map("otp_hash")
  attemptCount          Int       @default(0) @map("attempt_count")
  resendCount           Int       @default(0) @map("resend_count")
  lastSentAt            DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  lockedAt              DateTime? @map("locked_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([normalizedPhoneNumber, createdAt])
  @@index([expiresAt])
  @@index([normalizedPhoneNumber, consumedAt, lockedAt])
  @@map("otp_challenges")
}

model AuthenticationEvent {
  id              String                  @id @default(uuid(7)) @db.Uuid
  userId          String?                 @map("user_id") @db.Uuid
  type            AuthenticationEventType
  subjectHash     String?                 @map("subject_hash")
  sessionFamilyId String?                 @map("session_family_id") @db.Uuid
  metadata        Json?
  occurredAt      DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@map("authentication_events")
}

model IdempotencyRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String               @id @default(uuid(7)) @db.Uuid
  aggregateType String               @map("aggregate_type")
  aggregateId   String               @map("aggregate_id") @db.Uuid
  eventType     String               @map("event_type")
  payload       Json
  occurredAt    DateTime             @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(3)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?            @map("next_attempt_at") @db.Timestamptz(3)
  failedAt      DateTime?            @map("failed_at") @db.Timestamptz(3)
  lastErrorCode String?              @map("last_error_code")
  notifications NotificationRecord[]

  @@index([publishedAt, failedAt, nextAttemptAt, occurredAt, id])
  @@map("outbox_events")
}

model AuditEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  clinicId       String?       @map("clinic_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id") @db.Uuid
  outcome        AuditOutcome
  requestId      String        @map("request_id")
  metadata       Json?
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic         Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@map("audit_events")
}
