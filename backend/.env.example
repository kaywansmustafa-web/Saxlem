SAXLEM_BACKEND_ENV=development
PORT=3000
DATABASE_URL=postgresql://saxlem_dev_app:replace-with-local-development-password@localhost:5433/saxlem_development?schema=public
MIGRATION_DATABASE_URL=postgresql://saxlem_dev_admin:replace-with-local-development-admin-password@localhost:5433/saxlem_development?schema=public
TEST_DATABASE_URL=postgresql://saxlem_test_admin:replace-with-local-test-admin-password@localhost:5434/saxlem_test?schema=public
POSTGRES_USER=saxlem_dev_admin
POSTGRES_PASSWORD=replace-with-local-development-admin-password
POSTGRES_DB=saxlem_development
DEV_APP_USER=saxlem_dev_app
DEV_APP_PASSWORD=replace-with-local-development-app-password
TEST_POSTGRES_USER=saxlem_test_admin
TEST_POSTGRES_PASSWORD=replace-with-local-test-admin-password
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
OPENAPI_ENABLED=true
ACCESS_TOKEN_SECRET=development-only-change-before-production-32-characters
REFRESH_TOKEN_SECRET=development-only-change-before-production-32-characters
