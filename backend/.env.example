SAXLEM_BACKEND_ENV=development
PORT=3000
DATABASE_URL=postgresql://saxlem_dev_app:replace-with-local-development-password@localhost:5433/saxlem_development?schema=public
MIGRATION_DATABASE_URL=postgresql://saxlem_dev_admin:replace-with-local-development-admin-password@localhost:5433/saxlem_development?schema=public
TEST_DATABASE_URL=postgresql://saxlem_test_admin:replace-with-local-test-admin-password@localhost:5434/saxlem_test?schema=public
POSTGRES_USER=saxlem_dev_admin
POSTGRES_PASSWORD=replace-with-local-development-admin-password
POSTGRES_DB=saxlem_development
DEV_APP_USER=saxlem_dev_app
DEV_APP_PASSWORD=replace-with-local-development-app-password
TEST_POSTGRES_USER=saxlem_test_admin
TEST_POSTGRES_PASSWORD=replace-with-local-test-admin-password
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
# Load balancers in front of the API (set 1 behind one proxy) so rate limits see real client addresses.
TRUST_PROXY_HOPS=0
# Requests per minute per client address (writes get a fifth). 0 turns it off.
API_RATE_LIMIT_PER_MINUTE=600
OPENAPI_ENABLED=true
APPOINTMENT_PAST_TOLERANCE_MINUTES=2
APPOINTMENT_FOUNDATION_FEE_IQD=25000
APPOINTMENT_FOUNDATION_DURATION_MINUTES=30
ARRIVAL_EARLY_WINDOW_MINUTES=60
ARRIVAL_LATE_WINDOW_MINUTES=120
QUEUE_RECALL_GRACE_MINUTES=5
QUEUE_HEALTH_BUSY_THRESHOLD_MINUTES=10
QUEUE_HEALTH_DELAYED_THRESHOLD_MINUTES=25
QUEUE_FALLBACK_CONSULTATION_MINUTES=20
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_WORKER_TICK_LIMIT=20
NOTIFICATION_WORKER_MAX_ATTEMPTS=8
NOTIFICATION_WORKER_RETRY_BASE_MS=1000
NOTIFICATION_WORKER_RETRY_MAX_MS=300000
NOTIFICATION_SSE_POLL_INTERVAL_MS=1000
NOTIFICATION_SSE_HEARTBEAT_INTERVAL_MS=15000
NOTIFICATION_SSE_MAX_CONNECTION_MS=300000
NOTIFICATION_SSE_PAGE_SIZE=50
NOTIFICATION_SSE_MAX_RECONNECT_BACKLOG=1000
ACCESS_TOKEN_SECRET=development-only-change-before-production-32-characters
REFRESH_TOKEN_SECRET=development-only-change-before-production-32-characters
OTP_SECRET=development-only-otp-secret-change-before-production
AUDIT_HASH_SECRET=development-only-audit-secret-change-before-production

# Sign-in codes. development = no message is sent (dev and test only).
# Production: OTP_PROVIDER=otpiq with the project API key from otpiq.com.
OTP_PROVIDER=development
OTPIQ_API_KEY=
# auto (WhatsApp, Telegram, then SMS), sms, whatsapp or telegram
OTPIQ_CHANNEL=auto
# Drive time for "Leave by". estimate (distance only), tomtom (free key from
# developer.tomtom.com, no card; real roads, traffic where TomTom has it),
# google (traffic-aware; Routes API key from a Google Maps Platform project
# with billing) or osrm (self-hosted road routing, no traffic).
# The patient's location is never stored.
ROUTES_PROVIDER=estimate
TOMTOM_API_KEY=
GOOGLE_ROUTES_API_KEY=
OSRM_BASE_URL=
